{
  "name": "supramundane.agency",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "description": "supramundane.agency — static site, local CMS, and publisher",
  "author": "Robin Berjon <robin@berjon.com>",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node build/index.js",
    "cms": "node cms/server.js",
    "cms:ui": "node cms/bundle.js",
    "cms:ui:watch": "node cms/bundle.js --watch",
    "dev": "npm run cms:ui && node cms/server.js",
    "publish:site": "node cms/deploy.js",
    "sm:deploy": "cd deploy && sm deploy"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/darobin/supramundane.agency.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@atproto/api": "^0.19.5",
    "@lit-labs/signals": "^0.2.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "lit": "^3.3.2",
    "markdown-it": "^14.1.0",
    "refrakt": "^1.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
