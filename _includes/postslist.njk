<ol class="postlist">
{%- for post in postslist %}
	<li class="postlist-item">
		<a href="{{ post.url }}">{% if post.data.image %}<img src="{{ post | imagePath }}" alt="{{ post.data.imageAlt }}" width="280" height="175">{% endif %}</a>
		<a href="{{ post.url }}">{{ post.data.title }}</a>
		<time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
		{% if post.data.image %}<a href="https://www.openstreetmap.org/search?query={{ post.data.location | encodeURIComponent }}" class="location" target="_blank">{{ post.data.location }}</a>{% endif %}
		<p>{{ post.data.description }}</p>
	</li>
{%- endfor %}
</ol>
