---
layout: layouts/base.njk
---
<h1>{{ title }}</h1>

<div class="metadata">
	<time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>
	<ul>
  	{%- for tag in tags | filterTagList %}
     	{%- set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
     	<li><a href="{{ tagUrl }}" class="post-tag">{{ tag }}</a>{%- if not loop.last %}, {% endif %}</li>
  	{%- endfor %}
	</ul>
</div>

{{ content | safe }}

{%- if collections.news %}
{%- set previousPost = collections.news | getPreviousCollectionItem %}
{%- set nextPost = collections.news | getNextCollectionItem %}
{%- if nextPost or previousPost %}
<div class="links-nextprev">
	{%- if previousPost %}<div class="links-nextprev-prev">← Previous<br> <a href="{{ previousPost.url }}">{{ previousPost.data.title }}</a></div>{% endif %}
	{%- if nextPost %}<div class="links-nextprev-next">Next →<br><a href="{{ nextPost.url }}">{{ nextPost.data.title }}</a></div>{% endif %}
</div>
{%- endif %}
{%- endif %}
